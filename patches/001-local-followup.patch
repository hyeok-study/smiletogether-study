+        var dto = mock(ChannelMessageSaveRequest.class);
+        String json = "{\"type\":\"SEND\"}";
+        when(mapper.readTree(json)).thenReturn(new ObjectMapper().readTree(json));
+        when(mapper.readValue(json,ChannelMessageSaveRequest.class)).thenReturn(dto);
+        doThrow(new IllegalStateException("controlled DB write failure")).when(service).saveMessage(dto);

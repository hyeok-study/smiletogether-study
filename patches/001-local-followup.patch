+package com.smiletogether.historyserver.util;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.apache.kafka.clients.consumer.Consumer;
+import org.apache.kafka.clients.consumer.OffsetAndMetadata;
+import org.apache.kafka.common.PartitionInfo;
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.kafka.core.ConsumerFactory;
+import java.util.List;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class KafkaLagCheckerTest {
+    ConsumerFactory<String,String> factory;
+    Consumer<String,String> consumer;
+    KafkaLagChecker checker;
+    @BeforeEach
+    @SuppressWarnings("unchecked")
+    void setup() {
+        factory = mock(ConsumerFactory.class); consumer = mock(Consumer.class);
+        when(factory.createConsumer("group")).thenReturn(consumer);
+        when(consumer.partitionsFor("history-topic")).thenReturn(List.of(mock(PartitionInfo.class), mock(PartitionInfo.class), mock(PartitionInfo.class)));
+        checker = new KafkaLagChecker(factory);
+    }
+    @Test void minimumHashUsesValidSameLegacyPartition() {
+        String channel = "polygenelubricants";
+        assertEquals(Integer.MIN_VALUE, channel.hashCode());
+        TopicPartition partition = new TopicPartition("history-topic", 2);
+        when(consumer.position(partition)).thenReturn(10L);
+        when(consumer.committed(partition)).thenReturn(new OffsetAndMetadata(10));
+        assertTrue(checker.isPartitionUpToDate("history-topic", "group", channel));
+        verify(consumer).assign(List.of(partition));
+        verify(consumer).close();
+    }
+    @Test void missingCommitReturnsFalseAndClosesConsumer() {
+        when(consumer.position(any())).thenReturn(10L);
+        assertFalse(checker.isPartitionUpToDate("history-topic", "group", "channel"));
+        verify(consumer).close();
+    }
+    @Test void kafkaFailureReturnsFalseAndClosesConsumer() {
+        when(consumer.partitionsFor("history-topic")).thenThrow(new IllegalStateException("controlled outage"));
+        assertFalse(checker.isPartitionUpToDate("history-topic", "group", "channel"));
+        verify(consumer).close();
+    }
+    @Test void exhaustedBudgetChecksOnlyConfiguredAttempts() {
+        KafkaLagChecker controlled = spy(checker);
+        doReturn(false).when(controlled).isPartitionUpToDate(anyString(),anyString(),anyString());
+        assertFalse(controlled.waitUntilPartitionSynced("history-topic","group","channel",5,0));
+        verify(controlled,times(5)).isPartitionUpToDate("history-topic","group","channel");
+    }
+    @Test void interruptionStopsWaitingAndPreservesInterrupt() {
+        KafkaLagChecker controlled = spy(checker);
+        doReturn(false).when(controlled).isPartitionUpToDate(anyString(),anyString(),anyString());
+        try {
+            Thread.currentThread().interrupt();
+            assertFalse(controlled.waitUntilPartitionSynced("history-topic","group","channel",5,100));
+            assertTrue(Thread.currentThread().isInterrupted());
+            verify(controlled,times(1)).isPartitionUpToDate("history-topic","group","channel");
+        } finally { Thread.interrupted(); }
+    }
+}

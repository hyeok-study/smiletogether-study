+    @Test void minimumHashIsNonnegative() {
+        Cluster cluster = mock(Cluster.class);
+        when(cluster.partitionCountForTopic("channel-topic")).thenReturn(3);
+        String key = "polygenelubricants";
+        assertEquals(Integer.MIN_VALUE, key.hashCode());
+        assertEquals(2, new PartitionConfig().partition("channel-topic",key,null,null,null,cluster));
+    }
+    @Test void existingKeysKeepTheirOldPlacement() {
+        Cluster cluster = mock(Cluster.class);
+        when(cluster.partitionCountForTopic("channel-topic")).thenReturn(7);
+        for(String key : new String[]{"channel", "abc", "negative-channel", "", "한국어 채널"}) {
+            assertEquals(Math.abs(key.hashCode()) % 7,new PartitionConfig().partition("channel-topic",key,null,null,null,cluster));
+        }
+        assertEquals(0,new PartitionConfig().partition("channel-topic",null,null,null,null,cluster));
+    }
+}

+package com.smiletogether.historyserver.config;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.util.backoff.FixedBackOff;
+
+@Configuration
+public class HistoryKafkaRetryConfiguration {
+    @Bean
+    public DefaultErrorHandler historyPersistenceErrorHandler() {
+        // 실패한 partition을 막고 재시도한다. 영구 오류의 DLT/격리 정책은 별도 필요하다.
+        return new DefaultErrorHandler(new FixedBackOff(100, FixedBackOff.UNLIMITED_ATTEMPTS));
+    }
+}
